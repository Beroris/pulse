import { Theme, Icons } from "theme.slint";
import { App } from "state.slint";
import { ServiceRow, ColumnData } from "types.slint";
import { Icon, IconButton, Button, SearchBox, Segmented, Card, Badge, Select, Divider } from "widgets.slint";
import { ListView, ScrollView, HeaderCell } from "table.slint";

// Columns, in the order the controller sends them: name, display name, status, startup type, PID.
component ServiceItem inherits Rectangle {
    in property <ServiceRow> data;
    in property <int> index;
    in property <[ColumnData]> cols;
    in property <length> fill-w;
    property <length> w1: cols[1].width > 0 ? cols[1].width : fill-w;
    height: 34px;
    background: data.selected ? Theme.accent-soft : ta.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: data.display + ", " + data.status;
    accessible-item-selected: data.selected;
    ta := TouchArea { clicked => { App.service-select(root.index); } }
    HorizontalLayout {
        alignment: start;
        Rectangle {
            width: root.cols[0].width;
            Text { x: 12px; width: parent.width - 22px; text: root.data.name; color: Theme.secondary; font-size: Theme.small; vertical-alignment: center; overflow: elide; }
        }
        Rectangle {
            width: root.w1;
            Text { x: 10px; width: parent.width - 20px; text: root.data.display; color: Theme.text; font-size: Theme.body; vertical-alignment: center; overflow: elide; }
        }
        HorizontalLayout {
            width: root.cols[2].width;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 6px;
            Rectangle { width: 7px; height: 7px; border-radius: 3.5px; y: (parent.height - self.height) / 2; background: root.data.running ? Theme.good : Theme.tertiary.with-alpha(0.5); }
            Text { text: root.data.status; color: root.data.running ? Theme.text : Theme.secondary; font-size: Theme.small; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        }
        Rectangle {
            width: root.cols[3].width;
            Text { x: 10px; width: parent.width - 20px; text: root.data.start; color: Theme.secondary; font-size: Theme.small; vertical-alignment: center; overflow: elide; }
        }
        Rectangle {
            width: root.cols[4].width;
            Text { x: 10px; width: parent.width - 20px; text: root.data.pid; color: Theme.secondary; font-size: Theme.small; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
        }
    }
}

export component ServicesPage inherits Rectangle {
    property <length> fixed: App.service-fixed-width;
    property <length> fill-w: max(180px, lv.visible-width - fixed - 6px);
    property <length> content-w: (App.service-columns[1].width > 0 ? App.service-columns[1].width : fill-w) + fixed;
    VerticalLayout {
        padding: 28px;
        padding-top: 24px;
        padding-bottom: 16px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                spacing: -2px;
                min-width: 90px;
                horizontal-stretch: 1;
                Text { text: "Services"; color: Theme.text; font-size: Theme.title; font-weight: 600; overflow: elide; }
                Text { text: App.services-summary; color: Theme.tertiary; font-size: Theme.small; overflow: elide; }
            }
            SearchBox {
                min-width: 140px;
                preferred-width: 240px;
                horizontal-stretch: 0;
                y: (parent.height - self.height) / 2;
                placeholder: "Search services";
                text <=> App.services-search;
                edited(t) => { App.services-search-edited(t); }
            }
            Segmented {
                y: (parent.height - self.height) / 2;
                label: "Show";
                options: ["All", "Running", "Stopped"];
                selected <=> App.services-filter;
                changed(i) => { App.services-filter-changed(i); }
            }
            Select {
                y: (parent.height - self.height) / 2;
                width: 160px;
                label: "Startup type";
                options: ["Any startup type", "Automatic", "Manual", "Disabled"];
                selected <=> App.services-start-filter;
                changed(i) => { App.services-start-filter-changed(i); }
            }
            IconButton { icon: Icons.restart; tip: "Refresh"; y: (parent.height - self.height) / 2; clicked => { App.services-refresh(); } }
        }
        HorizontalLayout {
            spacing: 12px;
            Card {
                horizontal-stretch: 1;
                clip: true;
                // Right-click the header to put the columns back.
                ContextMenuArea {
                    y: 0;
                    height: 40px;
                    Menu {
                        MenuItem { title: "Reset column widths"; activated => { App.service-columns-reset(); } }
                    }
                    Rectangle {
                        y: 0;
                        height: 40px;
                        clip: true;
                        HorizontalLayout {
                            x: lv.content-x;
                            width: root.content-w;
                            alignment: start;
                            for c[i] in App.service-columns: HeaderCell {
                                width: c.width > 0 ? c.width : root.fill-w;
                                row-height: 40px;
                                pad-left: i == 0 ? 12px : 10px;
                                column: c;
                                clicked => { App.service-sort(i); }
                                resize-started => { App.service-resize-started(root.fill-w); }
                                resized(w) => { App.service-resized(i, w); }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.divider; }
                    }
                }
                lv := ListView {
                    y: 40px;
                    height: parent.height - 40px;
                    content-width: max(self.visible-width, root.content-w);
                    for r[i] in App.service-rows: ServiceItem { data: r; index: i; cols: App.service-columns; fill-w: root.fill-w; }
                }
                if App.services-loading && App.service-rows.length == 0: Text { y: 80px; width: parent.width; horizontal-alignment: center; text: "Reading services…"; color: Theme.tertiary; }
                if !App.services-loading && App.service-rows.length == 0: Text { y: 80px; width: parent.width; horizontal-alignment: center; text: "Nothing matches."; color: Theme.tertiary; }
            }
            if App.service-selected >= 0: Card {
                width: 360px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        VerticalLayout {
                            spacing: -2px;
                            horizontal-stretch: 1;
                            Text { text: App.service-display; color: Theme.text; font-size: Theme.heading; font-weight: 600; wrap: word-wrap; }
                            Text { text: App.service-name + " · " + App.service-status; color: Theme.tertiary; font-size: Theme.small; overflow: elide; }
                        }
                        IconButton { icon: Icons.close; tip: "Close"; clicked => { App.service-select(-1); } }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "Start"; icon: Icons.play; enabled: !App.service-running && !App.service-busy; clicked => { App.service-start(); } }
                        Button { text: "Stop"; icon: Icons.stop; enabled: App.service-running && App.service-can-stop && !App.service-busy; clicked => { App.service-stop(); } }
                        Button { text: "Restart"; icon: Icons.restart; enabled: App.service-running && App.service-can-stop && !App.service-busy; clicked => { App.service-restart(); } }
                    }
                    if App.service-start-choosable: HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Startup type"; color: Theme.secondary; font-size: Theme.small; vertical-alignment: center; }
                        Select {
                            horizontal-stretch: 1;
                            label: "Startup type";
                            options: ["Automatic", "Automatic (delayed)", "Manual", "Disabled"];
                            selected: max(0, App.service-start-index);
                            changed(i) => { App.service-set-start(i); }
                        }
                    }
                    if App.service-warning != "": Rectangle {
                        border-radius: Theme.radius-small;
                        background: Theme.warning.with-alpha(0.12);
                        min-height: wl.preferred-height;
                        wl := HorizontalLayout {
                            padding: 10px;
                            spacing: 8px;
                            Icon { d: Icons.warning; size: 15px; color: Theme.warning; }
                            Text { text: App.service-warning; color: Theme.text; font-size: Theme.small; wrap: word-wrap; horizontal-stretch: 1; }
                        }
                    }
                    Divider { }
                    ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: facts.preferred-height;
                        facts := VerticalLayout {
                            width: parent.visible-width;
                            spacing: 12px;
                            padding-right: 8px;
                            if App.service-description != "": Text { text: App.service-description; color: Theme.secondary; font-size: Theme.small; wrap: word-wrap; }
                            for f in App.service-facts: VerticalLayout {
                                spacing: -1px;
                                Text { text: f.label; color: Theme.tertiary; font-size: Theme.tiny; }
                                Text { text: f.value; color: Theme.text; font-size: Theme.small; wrap: word-wrap; }
                            }
                            if App.service-running: Button { text: "Go to process"; icon: Icons.processes; kind: 3; clicked => { App.service-go-to-process(); } }
                        }
                    }
                }
            }
        }
    }
}
