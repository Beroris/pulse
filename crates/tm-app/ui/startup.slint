import { Theme, Icons } from "theme.slint";
import { App } from "state.slint";
import { StartupRow, ColumnData } from "types.slint";
import { Icon, IconButton, Button, SearchBox, Segmented, Select, Card, Badge, Toggle, Divider } from "widgets.slint";
import { ListView, ScrollView, HeaderCell } from "table.slint";

// Columns, in the order the controller sends them: name, publisher, location, status.
component StartupItem inherits Rectangle {
    in property <StartupRow> data;
    in property <int> index;
    in property <[ColumnData]> cols;
    in property <length> fill-w;
    property <length> w0: cols[0].width > 0 ? cols[0].width : fill-w;
    height: 40px;
    background: data.selected ? Theme.accent-soft : ta.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: data.name + (data.enabled ? ", enabled" : ", disabled");
    accessible-item-selected: data.selected;
    ta := TouchArea { clicked => { App.startup-select(root.index); } }
    HorizontalLayout {
        alignment: start;
        HorizontalLayout {
            width: root.w0;
            padding-left: 12px;
            padding-right: 10px;
            spacing: 10px;
            Rectangle {
                width: 20px;
                if root.data.has-icon: Image { source: root.data.icon; width: 20px; height: 20px; image-rendering: smooth; }
                if !root.data.has-icon: Rectangle { width: 20px; height: 20px; border-radius: 6px; background: Theme.raised; Icon { d: Icons.startup; size: 12px; color: Theme.tertiary; } }
            }
            Text { text: root.data.name; color: root.data.enabled ? Theme.text : Theme.secondary; font-size: Theme.body; font-weight: 500; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            if root.data.missing: Badge { text: "File missing"; kind: 2; y: (parent.height - self.height) / 2; }
        }
        Rectangle {
            width: root.cols[1].width;
            Text { x: 10px; width: parent.width - 20px; text: root.data.publisher != "" ? root.data.publisher : "Unknown"; color: root.data.publisher != "" ? Theme.secondary : Theme.tertiary; font-size: Theme.small; vertical-alignment: center; overflow: elide; }
        }
        Rectangle {
            width: root.cols[2].width;
            Text { x: 10px; width: parent.width - 20px; text: root.data.source; color: Theme.secondary; font-size: Theme.small; vertical-alignment: center; overflow: elide; }
        }
        HorizontalLayout {
            width: root.cols[3].width;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            Toggle {
                y: (parent.height - self.height) / 2;
                checked: root.data.enabled;
                label: root.data.name;
                toggled(on) => { App.startup-toggle(root.index, on); }
            }
            Text { text: root.data.enabled ? "Enabled" : "Disabled"; color: root.data.enabled ? Theme.text : Theme.secondary; font-size: Theme.small; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            if root.data.needs-admin: Icon { d: Icons.shield; size: 13px; color: Theme.tertiary; y: (parent.height - self.height) / 2; }
        }
    }
}

export component StartupPage inherits Rectangle {
    property <length> fixed: App.startup-fixed-width;
    property <length> fill-w: max(180px, lv.visible-width - fixed - 6px);
    property <length> content-w: (App.startup-columns[0].width > 0 ? App.startup-columns[0].width : fill-w) + fixed;
    VerticalLayout {
        padding: 28px;
        padding-top: 24px;
        padding-bottom: 16px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                spacing: -2px;
                min-width: 90px;
                horizontal-stretch: 1;
                Text { text: "Startup"; color: Theme.text; font-size: Theme.title; font-weight: 600; overflow: elide; }
                Text { text: App.startup-summary; color: Theme.tertiary; font-size: Theme.small; overflow: elide; }
            }
            SearchBox {
                min-width: 140px;
                preferred-width: 240px;
                horizontal-stretch: 0;
                y: (parent.height - self.height) / 2;
                placeholder: "Search startup apps";
                text <=> App.startup-search;
                edited(t) => { App.startup-search-edited(t); }
            }
            Segmented {
                y: (parent.height - self.height) / 2;
                label: "Show";
                options: ["All", "Enabled", "Disabled"];
                selected <=> App.startup-filter;
                changed(i) => { App.startup-filter-changed(); }
            }
            Select {
                y: (parent.height - self.height) / 2;
                width: 150px;
                label: "Where it’s registered";
                options: ["Anywhere", "Registry", "Startup folders", "Store apps"];
                selected <=> App.startup-location;
                changed(i) => { App.startup-filter-changed(); }
            }
            IconButton { icon: Icons.restart; tip: "Refresh"; y: (parent.height - self.height) / 2; clicked => { App.startup-refresh(); } }
        }
        HorizontalLayout {
            spacing: 12px;
            Card {
                horizontal-stretch: 1;
                clip: true;
                // Right-click the header to put the columns back.
                ContextMenuArea {
                    y: 0;
                    height: 40px;
                    Menu {
                        MenuItem { title: "Reset column widths"; activated => { App.startup-columns-reset(); } }
                    }
                    Rectangle {
                        y: 0;
                        height: 40px;
                        clip: true;
                        HorizontalLayout {
                            x: lv.content-x;
                            width: root.content-w;
                            alignment: start;
                            for c[i] in App.startup-columns: HeaderCell {
                                width: c.width > 0 ? c.width : root.fill-w;
                                row-height: 40px;
                                pad-left: i == 0 ? 12px : 10px;
                                column: c;
                                clicked => { App.startup-sort(i); }
                                resize-started => { App.startup-resize-started(root.fill-w); }
                                resized(w) => { App.startup-resized(i, w); }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.divider; }
                    }
                }
                lv := ListView {
                    y: 40px;
                    height: parent.height - 40px;
                    content-width: max(self.visible-width, root.content-w);
                    for r[i] in App.startup-rows: StartupItem { data: r; index: i; cols: App.startup-columns; fill-w: root.fill-w; }
                }
                if App.startup-loading: Text { y: 80px; width: parent.width; horizontal-alignment: center; text: "Reading startup entries…"; color: Theme.tertiary; }
                if !App.startup-loading && App.startup-rows.length == 0: Text { y: 80px; width: parent.width; horizontal-alignment: center; text: App.startup-search == "" && App.startup-filter == 0 && App.startup-location == 0 ? "Nothing starts with Windows from the places this app checks." : "Nothing matches."; color: Theme.tertiary; }
            }
            if App.startup-selected >= 0: Card {
                width: 340px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        VerticalLayout {
                            spacing: -2px;
                            horizontal-stretch: 1;
                            Text { text: App.startup-name; color: Theme.text; font-size: Theme.heading; font-weight: 600; overflow: elide; }
                            Text { text: App.startup-publisher; color: Theme.tertiary; font-size: Theme.small; overflow: elide; }
                        }
                        IconButton { icon: Icons.close; tip: "Close"; clicked => { App.startup-select(-1); } }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            text: App.startup-enabled ? "Disable" : "Enable";
                            kind: 1;
                            icon: App.startup-needs-admin ? Icons.shield : "";
                            clicked => { App.startup-toggle(App.startup-selected, !App.startup-enabled); }
                        }
                        Button { text: "Open location"; icon: Icons.folder; enabled: App.startup-path != "" && !App.startup-missing; clicked => { App.startup-open-location(); } }
                    }
                    Divider { }
                    ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: facts.preferred-height;
                        facts := VerticalLayout {
                            width: parent.visible-width;
                            spacing: 12px;
                            padding-right: 8px;
                            VerticalLayout { spacing: -1px; Text { text: "Status"; color: Theme.tertiary; font-size: Theme.tiny; } Text { text: App.startup-enabled ? "Enabled: starts when you sign in" : "Disabled: Windows skips it"; color: Theme.text; font-size: Theme.small; wrap: word-wrap; } }
                            VerticalLayout { spacing: -1px; Text { text: "How it starts"; color: Theme.tertiary; font-size: Theme.tiny; } Text { text: App.startup-how; color: Theme.text; font-size: Theme.small; wrap: word-wrap; } }
                            VerticalLayout { spacing: -1px; Text { text: "Command"; color: Theme.tertiary; font-size: Theme.tiny; } Text { text: App.startup-command; color: Theme.text; font-size: Theme.small; wrap: word-wrap; } }
                            if App.startup-path != "": VerticalLayout { spacing: -1px; Text { text: "Program"; color: Theme.tertiary; font-size: Theme.tiny; } Text { text: App.startup-path; color: App.startup-missing ? Theme.warning : Theme.text; font-size: Theme.small; wrap: word-wrap; } }
                            VerticalLayout { spacing: -1px; Text { text: "Registered in"; color: Theme.tertiary; font-size: Theme.tiny; } Text { text: App.startup-source; color: Theme.text; font-size: Theme.small; wrap: word-wrap; } }
                            Text {
                                text: "Disabling keeps the entry and only tells Windows to skip it, using the same switch as Windows Task Manager and Settings. Enable it again any time.";
                                color: Theme.tertiary;
                                font-size: Theme.small;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
