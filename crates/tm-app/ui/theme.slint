// Colours, type and motion shared by every view. The palette is the Bero suite's (Orbit, Prism,
// Spotlight): near-black or near-white surfaces, one accent, amber and red only for warnings.

export global Theme {
    in-out property <bool> dark: true;
    // Set from code: the Windows accent (or the user's pick), already adjusted for contrast
    // against this theme's background.
    in-out property <color> accent: dark ? #60cdff : #005fb8;
    in-out property <color> on-accent: dark ? #000000 : #ffffff;
    in-out property <bool> motion: true;
    in-out property <bool> high-contrast: false;

    out property <color> background: dark ? #131315 : #fafafb;
    out property <color> sidebar: dark ? #0e0e10 : #f1f1f4;
    out property <color> card: dark ? #19191c : #ffffff;
    out property <color> raised: dark ? #202024 : #f4f4f7;
    out property <color> field: dark ? #232327 : #f9f9fb;
    out property <color> text: dark ? #f0f0f2 : #1a1a1d;
    out property <color> secondary: dark ? #a0a0a8 : #606069;
    out property <color> tertiary: dark ? #7a7a82 : #808088;
    out property <color> divider: dark ? #2c2c31 : #e2e2e7;
    out property <color> edge: dark ? #3a3a40 : #d4d4da;
    out property <color> selection: dark ? #2c2c31 : #e4e4e9;
    out property <color> hover: dark ? #ffffff0d : #0000000a;
    out property <color> pressed: dark ? #ffffff17 : #00000014;
    out property <color> danger: dark ? #f87171 : #b91c1c;
    out property <color> warning: dark ? #f5b042 : #ce7a06;
    out property <color> good: dark ? #4ade80 : #15803d;
    out property <color> scrim: dark ? #000000a0 : #00000060;
    // Second series in a graph (writes, sends): neutral, so it reads next to any accent.
    out property <color> series2: dark ? #c8c8d0 : #55555e;
    out property <color> accent-soft: accent.with-alpha(dark ? 0.16 : 0.12);
    out property <color> accent-fill: accent.with-alpha(dark ? 0.22 : 0.16);

    out property <duration> quick: motion ? 110ms : 0ms;
    out property <duration> calm: motion ? 220ms : 0ms;

    // Type scale. Geist's line boxes run a little tall, so stacked labels sit 2px tighter.
    out property <length> body: 13px;
    out property <length> small: 12px;
    out property <length> tiny: 11px;
    out property <length> heading: 15px;
    out property <length> title: 22px;
    out property <length> figure: 26px;

    out property <length> radius: 12px;
    out property <length> radius-small: 8px;
    out property <length> row: 32px;

    // A meter's colour: the accent while there's room, amber when getting full, red near the end.
    public pure function meter(v: float) -> color {
        return high-contrast ? text : v >= 0.9 ? danger : v >= 0.75 ? warning : accent;
    }
}

